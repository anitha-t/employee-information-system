# Copy to .env to override docker-compose defaults.
POSTGRES_USER=salary
POSTGRES_PASSWORD=salary
POSTGRES_DB=salary_management_development
POSTGRES_PORT=5432

# Host ports for the app containers.
API_PORT=3000
WEB_PORT=8080

# Seed on every API start (idempotent). The demo employees are created only on an empty database.
SEED_ON_START=true
SEED_EMPLOYEES=10000
