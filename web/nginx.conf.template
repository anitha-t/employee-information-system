# Rendered by the nginx image at start-up; ${API_UPSTREAM} comes from the environment.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # The Rails API, on the same origin as the app (session cookie, no CORS).
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }

  # Hashed build assets never change: cache them for a year.
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Client-side routes (/dashboard, /employees/...) all serve index.html, which is never cached.
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}
